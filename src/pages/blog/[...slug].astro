---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }).format(post.data.publishedAt);
---

<BaseLayout
  title={`${post.data.title} | Colégio JJR`}
  description={post.data.description}
  image={post.data.image}
  contentType="article"
  publishedAt={post.data.publishedAt}
  author={post.data.author}
>
  <header class="page-hero"><div class="shell"><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.publishedAt.toISOString()}>{date}</time></div><h1>{post.data.title}</h1><p>{post.data.description}</p></div></header>
  <img class="post-hero-image" src={post.data.image} alt={post.data.imageAlt} />
  <article class="prose"><Content /><p><em>{post.data.author}</em></p></article>
</BaseLayout>
