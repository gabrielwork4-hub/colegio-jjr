---
import BaseLayout from '../layouts/BaseLayout.astro';
import { internalPath } from '../utils/site';
---

<BaseLayout
  title="Página não encontrada | Colégio JJR"
  description="A página que você procurou não foi encontrada. Continue navegando pelo site do Colégio JJR."
  noindex
>
  <section class="page-hero">
    <div class="shell">
      <span class="eyebrow">Erro 404</span>
      <h1>Essa página não está por aqui.</h1>
      <p>O endereço pode ter mudado ou não existir mais. Você pode voltar ao início ou conhecer os principais caminhos do Colégio JJR.</p>
      <div class="hero-actions">
        <a class="button button-lime" href={internalPath('/')}>Voltar ao início</a>
        <a class="button button-navy" href={internalPath('/segmentos/')}>Conhecer os segmentos</a>
      </div>
    </div>
  </section>
</BaseLayout>
