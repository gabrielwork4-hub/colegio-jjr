---
import BaseLayout from '../layouts/BaseLayout.astro';
import { internalPath } from '../utils/site';
import { whatsappLink } from '../utils/school';
import IconBadge from '../components/IconBadge.astro';

const heroImage = '/fotos/home-escada.webp';
const segments = [
  { years: 'O Pequeno Galileu', title: 'Educação Infantil', text: 'Educação construtivista guiada por territórios de aprendizagem.' },
  { years: '1º ao 5º ano', title: 'Fundamental I', text: 'Alfabetização, letramento e projetos para aprender a aprender.' },
  { years: '6º ao 9º ano', title: 'Fundamental II', text: 'Aprofundamento científico, autonomia e pensamento crítico.' },
  { years: '1ª a 3ª série', title: 'Ensino Médio', text: 'Vestibulares, projeto de vida e escolhas conscientes para o futuro.' },
];
---

<BaseLayout title="Colégio JJR | Formando gente de valor" description="Do Infantil ao Ensino Médio no Rio Pequeno. Formação integral por princípios, inteligência emocional e valores que preparam para a vida.">
  <section class="structured-hero structured-hero--arrival">
    <div class="shell structured-hero-grid">
      <div class="structured-hero-copy">
        <span class="trust-chip hero-arrival" style="--arrival-delay: 40ms"><span aria-hidden="true">◆</span> Educação por princípios no Rio Pequeno</span>
        <h1 class="hero-arrival" style="--arrival-delay: 120ms">Escola que forma caráter sólido e gente de valor.</h1>
        <p class="hero-arrival" style="--arrival-delay: 220ms">Do Infantil ao Ensino Médio. Formação integral, inteligência emocional e valores que preparam para a vida.</p>
        <div class="hero-actions hero-arrival" style="--arrival-delay: 320ms">
          <a class="button button-lime" href={internalPath('/contato#visita')}>Visite nossa escola</a>
          <a class="button button-ghost" href={whatsappLink('Olá! Vim pelo site e gostaria de conhecer o Colégio JJR.')} rel="noopener noreferrer" target="_blank">Fale no WhatsApp</a>
        </div>
      </div>
      <div class="structured-visual hero-arrival-visual">
        <img src={internalPath(heroImage)} alt="Escada do Colégio JJR com um valor escrito em cada degrau, de vitória a foco" width="1100" height="1220" fetchpriority="high" />
        <span class="enrollment-chip">Visitas abertas</span>
        <div class="history-card"><strong>26 anos</strong><span>de história do grupo</span><small>26 anos Galileu e 16 anos JJR no Rio Pequeno</small></div>
      </div>
    </div>
  </section>

  <section class="section essence-section">
    <div class="shell">
      <header class="center-heading">
        <span class="eyebrow">Nossa essência</span>
        <h2>Filosofia educacional: formando caráter e intelecto</h2>
        <p>O conhecimento ganha força quando o estudante aprende também a escolher, conviver e assumir responsabilidade.</p>
      </header>
      <div class="essence-grid">
        <article class="essence-card">
          <IconBadge name="principles" />
          <h3>Princípios, não denominações</h3>
          <p>Valores cristãos não denominacionais orientam uma educação ética, sólida e amorosa.</p>
          <div class="card-note"><strong>Atendimento personalizado</strong><span>Cada aluno é visto e cuidado como indivíduo único.</span></div>
        </article>
        <article class="essence-card">
          <IconBadge name="sam" />
          <h3>Princípios na prática</h3>
          <ul class="check-list">
            <li><strong>Soberania:</strong> propósito e respeito à autoridade.</li>
            <li><strong>Autogoverno:</strong> domínio próprio e inteligência emocional.</li>
            <li><strong>Mordomia:</strong> cuidado com talentos e com o próximo.</li>
          </ul>
        </article>
        <article class="essence-card">
          <IconBadge name="routine" />
          <h3>Rotina com propósito</h3>
          <p>Devocionais diários e aula semanal de Ensino Bíblico conectam saber e discernimento moral.</p>
          <div class="card-note"><strong>Segurança e transparência</strong><span>Câmeras exclusivas para a Educação Infantil.</span></div>
        </article>
      </div>
      <blockquote class="institutional-quote">Não ensinamos uma religião; moldamos o caráter com princípios que transformam vidas e preparam para o futuro.</blockquote>
    </div>
  </section>

  <section class="highlights-strip" aria-label="Diferenciais do Colégio JJR">
    <div class="shell highlights-inner">
      <span><IconBadge name="bible" size="strip" /> Princípios bíblicos</span>
      <span><IconBadge name="innovation" size="strip" /> Tecnologia e inovação</span>
      <span><IconBadge name="creative" size="strip" /> Projetos criativos</span>
      <span><IconBadge name="care" size="strip" /> Cuidado próximo</span>
    </div>
  </section>

  <section class="section surface">
    <div class="shell">
      <header class="center-heading">
        <span class="eyebrow">As frentes da educação</span>
        <h2>Uma jornada contínua para cada fase da vida</h2>
      </header>
      <div class="education-grid">
        {segments.map((segment, index) => (
          <article class="education-card">
            <span class="segment-symbol" aria-hidden="true">{index + 1}</span>
            <small>{segment.years}</small>
            <h3>{segment.title}</h3>
            <p>{segment.text}</p>
            <a href={internalPath('/segmentos')}>Conheça o segmento</a>
          </article>
        ))}
      </div>
      <div class="center-action"><a class="button button-ghost" href={internalPath('/segmentos')}>Ver todos os segmentos</a></div>
    </div>
  </section>

  <section class="home-enrollment">
    <div class="shell home-enrollment-grid">
      <div class="campaign-year" aria-hidden="true">2027</div>
      <div class="campaign-copy">
        <span class="dark-chip">Matrículas 2027</span>
        <h2>O próximo ano começa com uma boa escolha.</h2>
        <p>Conheça uma escola que acompanha cada estudante de perto e une formação acadêmica, inteligência emocional e princípios.</p>
        <div class="hero-actions">
          <a class="button button-lime" href={internalPath('/matriculas-2027')}>Conheça o processo</a>
          <a class="button campaign-ghost" href={whatsappLink('Olá! Gostaria de receber os valores e as condições de matrícula para 2027.')} rel="noopener noreferrer" target="_blank">Receber valores e condições</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section home-stats">
    <div class="shell home-stats-grid">
      <div class="stats-copy">
        <span class="dark-chip">Tradição e inovação</span>
        <h2>Valores no coração.<br />Futuro no horizonte.</h2>
        <p>Não escolhemos entre princípios e inovação: formamos estudantes íntegros e preparados para o mundo complexo de hoje.</p>
        <a class="button button-lime" href={internalPath('/estrutura')}>Conheça nossos espaços</a>
      </div>
      <div class="legacy-story">
        <div class="history-line">
          <article><strong>26 anos</strong><span>de história do Galileu</span></article>
          <div class="history-connector" aria-hidden="true"></div>
          <article><strong>16 anos</strong><span>de tradição do Colégio JJR</span></article>
        </div>
        <p class="continuity-label">Uma história que continua no Rio Pequeno</p>
        <div class="school-offer">
          <div><strong>3 turnos</strong><span>manhã, tarde e integral</span></div>
          <div><strong>4 segmentos</strong><span>do Infantil ao Ensino Médio</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section final-blocks">
    <div class="shell final-grid">
      <article class="family-card">
        <IconBadge name="home" />
        <h2>Uma extensão do lar</h2>
        <p>Proximidade, diálogo e atenção individual criam um ambiente seguro para aprender. Escola e família caminham juntas durante toda a formação.</p>
        <a class="text-link" href={internalPath('/blog')}>Veja o cotidiano do JJR</a>
      </article>
      <article class="visit-card">
        <h2>Venha conhecer o JJR de perto</h2>
        <p>Agende uma visita e sinta a energia do dia a dia da nossa escola.</p>
        <div class="hero-actions">
          <a class="button button-navy" href={internalPath('/contato#visita')}>Agendar visita</a>
          <a class="button button-ghost" href={whatsappLink('Olá! Quero agendar uma visita ao Colégio JJR.')} rel="noopener noreferrer" target="_blank">Falar no WhatsApp</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
