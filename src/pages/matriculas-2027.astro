---
import BaseLayout from '../layouts/BaseLayout.astro';
import { school, whatsappLink } from '../utils/school';

const reasons = [
  ['Formação por princípios', 'Caráter, responsabilidade e propósito integrados à vida escolar.'],
  ['Acompanhamento próximo', 'Cada estudante é visto como indivíduo único em sua jornada.'],
  ['Inteligência emocional', 'Autogoverno, convivência e saúde emocional trabalhados no cotidiano.'],
  ['Futuro em perspectiva', 'Conhecimento, educação financeira, inovação e projeto de vida.'],
];

const segments = ['Educação Infantil', 'Ensino Fundamental I', 'Ensino Fundamental II', 'Ensino Médio'];
const shifts = ['Manhã', 'Tarde', 'Integral'];

const faqs = [
  ['Quais segmentos terão matrículas para 2027?', 'O atendimento contempla Educação Infantil, Ensino Fundamental I, Ensino Fundamental II e Ensino Médio. A disponibilidade de vagas é confirmada pela equipe para cada turma.'],
  ['O colégio oferece período integral?', 'Sim. O Colégio JJR trabalha com turnos da manhã e da tarde e também com período integral, conforme o segmento e a disponibilidade.'],
  ['Enviar o formulário garante uma vaga?', 'Não. O formulário inicia o contato com a equipe. A matrícula depende da disponibilidade da turma e da conclusão das etapas orientadas pela escola.'],
  ['Posso visitar a escola antes de decidir?', 'Sim. A visita é a melhor maneira de conhecer a proposta pedagógica, os ambientes e esclarecer dúvidas diretamente com a equipe.'],
] as const;
---

<BaseLayout title={`Matrículas 2027 | ${school.name}`} description={`Cadastre seu interesse nas matrículas 2027 do ${school.name} e agende uma visita para conhecer nossa proposta pedagógica.`} faqs={faqs}>
  <header class="enrollment-hero">
    <div class="shell enrollment-hero-grid">
      <div>
        <span class="enrollment-label">Matrículas 2027</span>
        <h1>Uma escolha que acompanha seu filho por inteiro.</h1>
        <p>Do Infantil ao Ensino Médio, o {school.name} une formação acadêmica, inteligência emocional e princípios em uma escola próxima das famílias.</p>
        <div class="hero-actions">
          <a class="button button-lime" href="#interesse">Cadastre seu interesse</a>
          <a class="button campaign-ghost" href={whatsappLink('Olá! Gostaria de informações sobre as matrículas 2027.')} target="_blank" rel="noopener noreferrer">Fale com a escola</a>
        </div>
      </div>
      <div class="year-poster" aria-label="Matrículas para o ano letivo de 2027">
        <span>ANO LETIVO</span>
        <strong>20<br />27</strong>
        <small>Conheça. Converse. Escolha com segurança.</small>
      </div>
    </div>
  </header>

  <section class="enrollment-facts" aria-label="Segmentos e turnos">
    <div class="shell enrollment-facts-grid">
      <div><strong>4 segmentos</strong><span>do Infantil ao Ensino Médio</span></div>
      <div><strong>3 turnos</strong><span>manhã, tarde e integral</span></div>
      <div><strong>Rio Pequeno</strong><span>São Paulo, SP</span></div>
    </div>
  </section>

  <section class="section surface">
    <div class="shell">
      <header class="center-heading"><span class="eyebrow">O primeiro passo</span><h2>Um processo próximo desde o início</h2><p>Sem pressa artificial: informação clara para a família tomar uma decisão segura.</p></header>
      <ol class="admission-steps">
        <li><span>1</span><div><h3>Conte o que você procura</h3><p>Informe o segmento, a série pretendida e a melhor forma de contato.</p></div></li>
        <li><span>2</span><div><h3>Conheça a escola</h3><p>Agende uma visita para conversar sobre a proposta e percorrer os ambientes.</p></div></li>
        <li><span>3</span><div><h3>Receba as orientações</h3><p>A equipe confirma a disponibilidade e apresenta os próximos passos da matrícula.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section enrollment-reasons">
    <div class="shell reasons-grid">
      <div class="reasons-intro"><span class="eyebrow">Por que o JJR</span><h2>Conhecimento com fundamento.</h2><p>Uma formação que prepara para provas, decisões, relações e responsabilidades da vida real.</p></div>
      <div class="reason-list">{reasons.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div>
  </section>

  <section class="section surface">
    <div class="shell faq-grid">
      <div><span class="eyebrow">Perguntas frequentes</span><h2>Para decidir com clareza.</h2></div>
      <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </div>
  </section>

  <section id="interesse" class="section enrollment-form-section">
    <div class="shell enrollment-form-grid">
      <div>
        <span class="dark-chip">Interesse em 2027</span>
        <h2>Vamos conversar sobre a próxima etapa?</h2>
        <p>Preencha os dados essenciais. A equipe do JJR entrará em contato para orientar sua família.</p>
        <p class="form-assurance">Este cadastro não confirma nem reserva uma vaga.</p>
      </div>
      <form class="form-card enrollment-contact-form" id="matriculas-2027" data-whatsapp-base={whatsappLink('Olá! Tenho interesse nas matrículas 2027 do Colégio JJR.')}>
        <p class="form-intro">Em poucos passos, direcionamos você para uma conversa com a equipe.</p>
        <div class="field"><label for="responsavel">Nome do responsável</label><input id="responsavel" name="responsavel" autocomplete="name" required /></div>
        <div class="field-grid">
          <div class="field"><label for="telefone-2027">WhatsApp</label><input id="telefone-2027" name="telefone" type="tel" autocomplete="tel" required /></div>
          <div class="field"><label for="email-2027">E-mail (opcional)</label><input id="email-2027" name="email" type="email" autocomplete="email" /></div>
        </div>
        <div class="field"><label for="aluno">Nome do estudante</label><input id="aluno" name="aluno" required /></div>
        <fieldset class="choice-fieldset">
          <legend>Qual segmento procura?</legend>
          <div class="choice-grid">
            {segments.map((segment) => <label class="choice-card"><input type="radio" name="segmento" value={segment} required /><span>{segment}</span></label>)}
          </div>
        </fieldset>
        <div class="field-grid">
          <div class="field"><label for="serie">Série pretendida</label><select id="serie" name="serie" data-grade-select required disabled><option value="">Escolha o segmento primeiro</option></select></div>
          <fieldset class="choice-fieldset compact-choice-fieldset">
            <legend>Turno de interesse</legend>
            <div class="choice-grid choice-grid-compact">
              {shifts.map((shift) => <label class="choice-card"><input type="radio" name="turno" value={shift} required /><span>{shift}</span></label>)}
            </div>
          </fieldset>
        </div>
        <fieldset class="choice-fieldset compact-choice-fieldset">
          <legend>Como podemos ajudar?</legend>
          <div class="choice-grid choice-grid-compact">
            <label class="choice-card"><input type="radio" name="interesse" value="Receber valores e condições" required /><span>Valores e condições</span></label>
            <label class="choice-card"><input type="radio" name="interesse" value="Agendar uma visita" required /><span>Agendar visita</span></label>
            <label class="choice-card"><input type="radio" name="interesse" value="Tirar dúvidas" required /><span>Tirar dúvidas</span></label>
          </div>
        </fieldset>
        <p class="form-disclosure">Ao continuar, abriremos uma conversa no WhatsApp com seus dados preenchidos para revisão. O envio da mensagem só acontece se você confirmar no WhatsApp.</p>
        <button class="button button-navy" type="submit">Continuar no WhatsApp</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const gradeOptions: Record<string, string[]> = {
    'Educação Infantil': ['Berçário', 'Maternal', 'Jardim I', 'Jardim II'],
    'Ensino Fundamental I': ['1º ano', '2º ano', '3º ano', '4º ano', '5º ano'],
    'Ensino Fundamental II': ['6º ano', '7º ano', '8º ano', '9º ano'],
    'Ensino Médio': ['1ª série', '2ª série', '3ª série'],
  };

  const form = document.querySelector<HTMLFormElement>('#matriculas-2027');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const values = new FormData(form);
    const message = [
      'Olá! Vim pelo site e gostaria de receber informações sobre as Matrículas 2027.',
      '',
      `Responsável: ${values.get('responsavel')}`,
      `Estudante: ${values.get('aluno')}`,
      `Segmento: ${values.get('segmento')}`,
      `Série pretendida: ${values.get('serie')}`,
      `Turno de interesse: ${values.get('turno')}`,
      `Quero: ${values.get('interesse')}`,
      `Telefone: ${values.get('telefone')}`,
      `E-mail: ${values.get('email') || 'Não informado'}`,
    ].join('\\n');

    const baseUrl = form.dataset.whatsappBase?.split('?')[0];
    if (baseUrl) window.location.href = `${baseUrl}?text=${encodeURIComponent(message)}`;
  });

  form?.querySelectorAll<HTMLInputElement>('[name="segmento"]').forEach((segment) => {
    const grade = form?.querySelector<HTMLSelectElement>('[data-grade-select]');
    segment.addEventListener('change', () => {
      if (!grade) return;
      grade.replaceChildren(new Option('Selecione a série', ''));
      (gradeOptions[segment.value] || []).forEach((label) => grade.add(new Option(label, label)));
      grade.disabled = !gradeOptions[segment.value];
    });
  });
</script>

<style>
  .form-intro { margin: 0; color: var(--muted); font-size: .94rem; }
  .choice-fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .choice-fieldset legend { margin-bottom: .7rem; color: var(--navy); font: 800 .85rem/1.35 var(--display); }
  .choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .choice-grid-compact { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .choice-card { position: relative; display: flex; align-items: center; min-height: 3.2rem; padding: .75rem .85rem; border: 1px solid var(--line); border-radius: .8rem; color: var(--muted); background: var(--white); cursor: pointer; font: 700 .78rem/1.25 var(--display); transition: border-color .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease; }
  .choice-card:hover { border-color: var(--lime-ink); color: var(--navy); }
  .choice-card input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .choice-card:has(input:focus-visible) { outline: 3px solid rgb(187 228 54 / 55%); outline-offset: 2px; }
  .choice-card:has(input:checked) { border-color: var(--lime-ink); color: var(--navy); background: var(--lime); box-shadow: inset 0 0 0 1px var(--lime-ink); }
  .form-disclosure { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.5; }
  @media (max-width: 620px) {
    .choice-grid, .choice-grid-compact { grid-template-columns: 1fr; }
  }
</style>
