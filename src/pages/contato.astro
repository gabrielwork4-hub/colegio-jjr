---
import BaseLayout from '../layouts/BaseLayout.astro';
import { school, fullStreet, mapsQuery, mapsEmbed, whatsappLink } from '../utils/school';
---

<BaseLayout title={`Contato e visita | ${school.name}`} description={`Agende uma visita ao ${school.name} no Rio Pequeno, São Paulo, ou fale conosco por telefone e WhatsApp.`} pageType="ContactPage">
  <header class="page-hero"><div class="shell"><span class="eyebrow">Vamos conversar</span><h1>Venha sentir a escola de perto.</h1><p>Conheça o {school.name}, caminhe pelos espaços e tire suas dúvidas com a nossa equipe.</p></div></header>
  <section class="section-tight"><div class="shell contact-grid">
    <div>
      <h2>Você escolhe o canal.</h2>
      <p>Estamos no {school.address.district}, em {school.address.city}. A secretaria atende de segunda a sexta, das {school.officeHours.opens} às {school.officeHours.closes}.</p>
      <div class="contact-list">
        <a class="contact-item" href={school.phone.href}><strong>Telefone</strong><br />{school.phone.label}</a>
        <a class="contact-item" href={school.whatsapp.href} target="_blank" rel="noopener noreferrer"><strong>WhatsApp</strong><br />{school.whatsapp.label}</a>
        <a class="contact-item" href={`mailto:${school.email}`}><strong>E-mail</strong><br />{school.email}</a>
        <a class="contact-item" href={mapsQuery} target="_blank" rel="noopener noreferrer"><strong>Endereço</strong><br />{fullStreet}</a>
      </div>
    </div>
    <form id="visita" class="form-card" data-whatsapp-lead data-whatsapp-base={whatsappLink('Olá! Gostaria de falar com a equipe do Colégio JJR.')}>
      <h2>Agende uma visita</h2>
      <p>Conte um pouco sobre o que procura. Ao enviar, seus dados serão organizados em uma mensagem para o WhatsApp da escola.</p>
      <div class="field"><label for="nome">Nome do responsável</label><input id="nome" name="nome" autocomplete="name" required /></div>
      <div class="field-grid">
        <div class="field"><label for="telefone">Seu WhatsApp</label><input id="telefone" name="telefone" type="tel" autocomplete="tel" required /></div>
        <div class="field"><label for="email">E-mail (opcional)</label><input id="email" name="email" type="email" autocomplete="email" /></div>
      </div>
      <div class="field"><label for="assunto">Como podemos ajudar?</label><select id="assunto" name="assunto" required><option value="">Selecione</option><option>Agendar uma visita</option><option>Informações sobre matrícula</option><option>Tirar uma dúvida</option></select></div>
      <div class="field"><label for="segmento">Segmento de interesse</label><select id="segmento" name="segmento" required><option value="">Selecione</option><option>Educação Infantil</option><option>Ensino Fundamental I</option><option>Ensino Fundamental II</option><option>Ensino Médio</option></select></div>
      <div class="field"><label for="mensagem">Mensagem (opcional)</label><textarea id="mensagem" name="mensagem" placeholder="Escreva sua dúvida ou preferência de dia e horário."></textarea></div>
      <button class="button button-navy" type="submit">Continuar no WhatsApp</button>
      <p class="form-assurance" data-form-status aria-live="polite">Ao continuar, o WhatsApp será aberto com sua mensagem pronta para envio.</p>
    </form>
  </div></section>
  <section class="section-tight contact-map-section" aria-labelledby="contact-map-title">
    <div class="shell">
      <div class="contact-map-heading">
        <div>
          <span class="eyebrow">Como chegar</span>
          <h2 id="contact-map-title">Estamos no Rio Pequeno.</h2>
          <p>{fullStreet}, {school.address.city}/{school.address.region} — CEP {school.address.postalCode}.</p>
        </div>
        <a class="button button-ghost" href={mapsQuery} target="_blank" rel="noopener noreferrer">Abrir no Google Maps</a>
      </div>
      <div class="contact-map-frame">
        <iframe src={mapsEmbed} title={`Mapa de localização do ${school.name}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-whatsapp-lead]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const fields = new FormData(form);
      const details = [...fields.entries()]
        .filter(([key, value]) => key !== 'mensagem' && String(value).trim())
        .map(([key, value]) => `*${key[0].toUpperCase()}${key.slice(1)}:* ${String(value).trim()}`);
      const message = `${decodeURIComponent(form.dataset.whatsappBase!.split('?text=')[1] || '')}\n\n${details.join('\n')}${String(fields.get('mensagem') || '').trim() ? `\n*Mensagem:* ${String(fields.get('mensagem')).trim()}` : ''}`;
      window.location.href = `${form.dataset.whatsappBase!.split('?')[0]}?text=${encodeURIComponent(message)}`;
    });
  });
</script>
