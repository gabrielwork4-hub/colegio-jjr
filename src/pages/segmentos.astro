---
import BaseLayout from '../layouts/BaseLayout.astro';
import { internalPath } from '../utils/site';

const segments = [
  {
    title: 'Educação Infantil', subtitle: 'O Pequeno Galileu',
    text: 'Os primeiros anos ganham significado em territórios de aprendizagem que acolhem a curiosidade, o brincar e a descoberta.',
    items: ['Metodologia construtivista', '26 anos de experiência do grupo', 'Monitoramento por câmeras para os pais'],
    imageAlt: 'Aluno da Educação Infantil do Colégio JJR segurando uma lupa no jardim',
    image: '/fotos/segmento-infantil-lupa.webp',
    external: true,
  },
  {
    title: 'Ensino Fundamental I', subtitle: 'Base forte para aprender a aprender',
    text: 'Alfabetização, raciocínio e convivência avançam juntos, com proximidade entre professores, estudantes e famílias.',
    items: ['Educação por Princípios', 'Escola da Inteligência', 'Gênios das Finanças'],
    image: '/images/fotos/segmento-fundamental-1-material-positivo.jpg',
  },
  {
    title: 'Ensino Fundamental II', subtitle: 'Autonomia com acompanhamento',
    text: 'Novos desafios acadêmicos encontram uma rotina estruturada, capaz de desenvolver responsabilidade e pensamento crítico.',
    items: ['Formação acadêmica consistente', 'Inteligência emocional e saúde mental', 'Educação financeira prática'],
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuD5JjoMj35rW5hQDgX0yALQzr4jRb8fF2nZV7KNi4CcxvdtkgWYwN3-5CEYydtJiINLv8AvAFa44d1WVIXWySMxVEzwbDl8FyBWtGiwkUxdPUyfktrg-OmXXWn1urwGxDYxkPGL3Z99zJLryNqAtnMiiXWASZJizaIZOOZ9JtVsF7t4-QQaZzIAa9lXYLKCh_mqq9Y9KtCBO6pp4LblPF-dZsS1An24yg4C1alFuLIfiOOOnw01Mo5g',
  },
  {
    title: 'Ensino Médio', subtitle: 'Escolhas conscientes para o futuro',
    text: 'Preparação acadêmica de alta performance sem perder de vista o projeto de vida e a singularidade de cada estudante.',
    items: ['Simulados ENEM e vestibulares', 'Orientação de escolha profissional', 'Acompanhamento individual da jornada'],
    image: '/fotos/segmento-ensino-medio-horizontal.webp',
    imageAlt: 'Aluno do Ensino Médio do Colégio JJR concentrado em uma atividade no caderno',

  },
];
---

<BaseLayout title="Etapas de ensino no Rio Pequeno | Colégio JJR" description="Conheça a Educação Infantil, o Fundamental I e II e o Ensino Médio do Colégio JJR, no Rio Pequeno, com acompanhamento próximo em cada etapa.">
  <header class="page-hero"><div class="shell"><span class="eyebrow">Uma jornada completa</span><h1>Cada fase pede um jeito de ensinar.</h1><p>Do primeiro passo à escolha da profissão, respeitamos o ritmo e as potencialidades de cada etapa.</p></div></header>
  <section class="section-tight"><div class="shell segment-list">
    {segments.map((segment) => (
      <article class="segment">
        <div class="segment-image" style={`background-image:url('${internalPath(segment.image)}')`} role="img" aria-label={segment.imageAlt ?? `Estudantes do segmento ${segment.title}`}></div>
        <div class="segment-copy"><span class="eyebrow">{segment.subtitle}</span><h2>{segment.title}</h2><p>{segment.text}</p><ul>{segment.items.map((item) => <li>{item}</li>)}</ul>{segment.external && <a class="text-link" href="https://opequenogalileu.com.br" rel="nofollow noopener noreferrer" target="_blank">Conheça O Pequeno Galileu</a>}</div>
      </article>
    ))}
  </div></section>
  <section class="section-tight" aria-labelledby="segment-visit-title">
    <div class="shell segment-cta">
      <div><span class="eyebrow">Conheça o JJR</span><h2 id="segment-visit-title">Descubra de perto a etapa do seu filho.</h2><p>Converse com a equipe sobre a rotina, a proposta pedagógica e as possibilidades para 2027.</p></div>
      <div class="hero-actions"><a class="button button-lime" href={internalPath('/matriculas-2027/')}>Informações de matrícula</a><a class="button campaign-ghost" href={internalPath('/contato#visita')}>Agendar uma visita</a></div>
    </div>
  </section>
</BaseLayout>
