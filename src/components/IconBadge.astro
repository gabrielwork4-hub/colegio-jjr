---
interface Props {
  name: 'principles' | 'sam' | 'routine' | 'bible' | 'innovation' | 'creative' | 'care' | 'home';
  size?: 'card' | 'strip';
}

const { name, size = 'card' } = Astro.props;
---

<span class:list={['icon-badge', `icon-badge--${size}`]} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {name === 'principles' && <><circle cx="12" cy="12" r="8.5"/><path d="m15.8 8.2-2.2 5.4-5.4 2.2 2.2-5.4 5.4-2.2Z"/><circle cx="12" cy="12" r=".8" fill="currentColor" stroke="none"/></>}
    {name === 'sam' && <><circle cx="12" cy="5" r="2.5"/><circle cx="5.5" cy="18" r="2.5"/><circle cx="18.5" cy="18" r="2.5"/><path d="m10.8 7.2-4 8.5M13.2 7.2l4 8.5M8 18h8"/></>}
    {name === 'routine' && <><rect x="3.5" y="5.5" width="17" height="15" rx="2.5"/><path d="M7.5 3.5v4M16.5 3.5v4M3.5 10h17M8 15l2.2 2.2L16 12.5"/></>}
    {name === 'bible' && <><path d="M4 5.5c3.3-.5 5.9.3 8 2.3v11c-2.1-2-4.7-2.8-8-2.3v-11ZM20 5.5c-3.3-.5-5.9.3-8 2.3v11c2.1-2 4.7-2.8 8-2.3v-11Z"/><path d="M12 8v11"/></>}
    {name === 'innovation' && <><path d="M9 18h6M9.5 21h5M8.6 14.5A6 6 0 1 1 15.4 14.5C14.5 15.2 14 16 14 17h-4c0-1-.5-1.8-1.4-2.5Z"/><path d="M12 2V.8M4.9 4.9 4 4M19.1 4.9 20 4"/></>}
    {name === 'creative' && <><path d="m4 16.5-1 4.5 4.5-1L19 8.5 15.5 5 4 16.5Z"/><path d="m13.8 6.7 3.5 3.5M6.2 17.2l1.6 1.6M18.5 2v2M21 4.5h-2M5 3v2M7.5 5.5h-2"/></>}
    {name === 'care' && <><path d="M20.2 5.8a5 5 0 0 0-7.1 0L12 6.9l-1.1-1.1a5 5 0 0 0-7.1 7.1L12 21l8.2-8.1a5 5 0 0 0 0-7.1Z"/><path d="M8.8 11.7 11 14l4.4-4.5"/></>}
    {name === 'home' && <><path d="m3.5 11 8.5-7 8.5 7"/><path d="M5.5 9.5v10h13v-10M9.5 19.5v-6h5v6"/></>}
  </svg>
</span>
