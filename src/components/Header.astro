---
import { internalPath } from '../utils/site';

const pathname = Astro.url.pathname;
const home = internalPath('/');
const links = [
  { href: home, label: 'Início' },
  { href: internalPath('/segmentos'), label: 'Segmentos' },
  { href: internalPath('/estrutura'), label: 'Estrutura' },
  { href: internalPath('/blog'), label: 'Por dentro do JJR' },
  { href: internalPath('/contato'), label: 'Contato' },
];

// Um artigo mantém "Por dentro do JJR" marcado; só a home exige igualdade.
const isCurrent = (href: string) => (href === home ? pathname === home : pathname.startsWith(href));
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href={internalPath('/')} aria-label="Colégio JJR — página inicial">
      <span class="brand-mark" aria-hidden="true">J</span>
      <span><strong>Colégio JJR</strong><small>Educação por princípios</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <a class="button button-lime header-cta" href={internalPath('/matriculas-2027')}>Matrículas 2027</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="Navegação móvel" hidden>
    {links.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
    <a class="button button-lime" href={internalPath('/matriculas-2027')}>Matrículas 2027</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu');
    menu.hidden = open;
  });
</script>
