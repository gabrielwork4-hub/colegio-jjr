---
import { internalPath } from '../utils/site';
import { school } from '../utils/school';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand brand-light" href={internalPath('/')}>
        <img class="brand-mark" src={internalPath('/logo-jjr.png')} alt="" width="33" height="42" />
        <span><strong>{school.name}</strong><small>{school.tagline}</small></span>
      </a>
      <p>Caráter sólido, conhecimento e inteligência emocional para formar gente de valor.</p>
      <small>CNPJ {school.taxId}</small>
      <img class="footer-positivo" src={internalPath('/fotos/sistema-positivo-selo.webp')} alt="Sistema de Ensino Positivo" width="80" height="80" loading="lazy" decoding="async" />
    </div>
    <div>
      <h2>Explore</h2>
      <a href={internalPath('/sobre-nos')}>Sobre nós</a>
      <a href={internalPath('/segmentos')}>Segmentos</a>
      <a href={internalPath('/estrutura')}>Estrutura</a>
      <a href={internalPath('/blog')}>Por dentro do JJR</a>
      <a href={internalPath('/contato')}>Contato</a>
    </div>
    <div>
      <h2>Fale com a escola</h2>
      <address>{school.address.street}<br />{school.address.district}, {school.address.city}/{school.address.region}<br />CEP {school.address.postalCode}</address>
      <a href={school.phone.href}>{school.phone.label}</a>
      <a href={school.whatsapp.href} target="_blank" rel="noopener noreferrer">WhatsApp: {school.whatsapp.label}</a>
      <a href={`mailto:${school.email}`}>{school.email}</a>
      <div class="footer-social" aria-label="Redes sociais">
        <a href={school.facebook} target="_blank" rel="noopener noreferrer" aria-label={`Facebook do ${school.name}`}><img src={internalPath('/social/facebook.png')} alt="" width="40" height="40" loading="lazy" /></a>
        <a href={school.instagram} target="_blank" rel="noopener noreferrer" aria-label={`Instagram do ${school.name}`}><img src={internalPath('/social/instagram.png')} alt="" width="40" height="40" loading="lazy" /></a>
        <a href={school.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn do ${school.name}`}><img src={internalPath('/social/linkedin.png')} alt="" width="40" height="40" loading="lazy" /></a>
        <a href={school.youtube} target="_blank" rel="noopener noreferrer" aria-label={`YouTube do ${school.name}`}><img src={internalPath('/social/youtube.png')} alt="" width="40" height="40" loading="lazy" /></a>
      </div>
    </div>
  </div>
  <div class="footer-bottom shell">
    <span>© {new Date().getFullYear()} {school.legalName}.</span>
  </div>
</footer>
